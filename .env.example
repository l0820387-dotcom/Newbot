# Telegram Bot
BOT_TOKEN=your_bot_token_from_botfather
BOT_USERNAME=your_bot_username_without_at

# FamPay Payment Gateway (optional — can also be set from bot's admin panel)
FAMPAY_API_KEY=your_fampay_api_key
