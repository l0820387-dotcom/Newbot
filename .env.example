# Telegram Bot
BOT_TOKEN=your_bot_token_from_botfather
# Your bot's @username WITHOUT the @ (e.g. MyShopBot) — used by the payment
# landing pages to auto-redirect users back into the bot after paying, and
# by the admin panel's "Share Link" feature for products.
BOT_USERNAME=your_bot_username

# ZapUPI Payment Gateway (docs: https://zapupi.com/docs)
ZABUPI_API_KEY=your_zap_key
ZABUPI_BASE_URL=https://pay.zapupi.com/api

# Server
PORT=3000
WEBHOOK_BASE_URL=https://your-app.up.railway.app

# Admin — your Telegram numeric ID(s), comma-separated. Get yours from
# @userinfobot on Telegram. Only these IDs can use /admin.
ADMIN_TELEGRAM_IDS=123456789,987654321

# ⚠️ DATA STORAGE WARNING ⚠️
# This bot stores all data (products, orders, users, wallets) as local JSON
# files under ./data/ — NOT in a cloud database. On platforms like Railway,
# the filesystem is EPHEMERAL: every redeploy or restart wipes ./data/ and
# permanently deletes everything. Use /admin -> Backup Data regularly and
# keep the downloaded JSON file somewhere safe.
